#making a sequence
seq(from=1, to=10, by=2)
 1, 3, 5, 7

#repeating a number
rep(1, times=10)

#repeating a sequence
rep(seq(from=5, to=15, by=3), times=2)
 5  8 11 14  5  8 11 14

#repeating a character
rep(c("s","a","m"), times=2)
  "s" "a" "m" "s" "a" "m" 

#combining collapse function with rep function
rep(1:3, times = 2)
# 1 2 3 1 2 3

paste(rep(1:3, times = 2), collapse = "-")
# "1-2-3-1-2-3"

#extracting a specific element
x <- 5:9
x[3]
# 7

#extracting multiple elements
x[c(1,5)]
# 5,9

#extracting all elements except n
x[-c(1,5)]
# 6 7 8

#extracting element where x is < 6
x[x<6]


#creating a matrix
matrix(c(1:9),nrow=3,byrow=TRUE)  #byrow determines if count will ascend through row or column

   [,1] [,2] [,3]
[1,]    1    2    3
[2,]    4    5    6
[3,]    7    8    9

#when byrow=FALSE
matrix(c(1:9),nrow=3,byrow=FALSE)

[,1] [,2] [,3]
[1,]    1    4    7
[2,]    2    5    8
[3,]    3    6    9

#defining mat as a matrix
mat <- matrix(c(1:9),nrow=3,byrow=TRUE)

#pulling out specific element in a matrix
mat[1,2]
 2

#pulling out multiple elements in a matrix
mat[c(1,3), 2]
 # pulls out value from row 1 and row 3 from column 2

#pulling out multiple elements from a column
mat[2,]

#pulling out all rows from a column
mat[,1]

#multiplying all elements in a matrix
mat*10
