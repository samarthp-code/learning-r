# creating a numeric vector
num_vect <- c(.5, 55, -10, 6)

# using a logical condition to compare each element
tf <- num_vect < 1

# printing the result - a vector of TRUE/FALSE for each element
tf
TRUE FALSE TRUE FALSE

# logical operators: & (and), | (or), ! (not)

# both conditions must be true
(3 > 5) & (4 == 4)   # FALSE, because 3 > 5 is false

# at least one condition must be true
(TRUE == TRUE) | (TRUE == FALSE)   # TRUE, because the first part is true

# negation flips TRUE/FALSE
!(TRUE)   # FALSE

# character vector
my_char <- c("My", "name", "is")

my_char = "My"     "name"    "is"  

# joining vector elements into one string, separated by spaces
paste(my_char, collapse = " ")       ## Collapsing makes it so vector is only values change from 3 -> 1

my_char = "My name is"


# adding your name to the end of a character vector
my_name <- c(my_char, "Samarth")

my_name = "My"   "name"    "is"    "Samarth"

# joining the updated vector into one string
paste(my_name, collapse = " ")      ## paste() joins pieces of text together into one string

"My name is Samarth"

# sep example - gluing two separate vectors together, pairing elements one by one
paste(1:3, c("X", "Y", "Z"), sep = "")
"1X" "2Y" "3Z"      #sep = ""  2+ seperate items that I want to combine

## Sep keeps the vector value the same
## Collapse changes vector value to 1

